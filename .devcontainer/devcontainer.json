{
  "name": "builder-repo-env",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/php:1": {
      "version": "8.3"
    }
  },
  "postCreateCommand": "npm install -g pnpm && pnpm install && npx playwright install --with-deps chromium",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-playwright.playwright",
        "bradlc.vscode-tailwindcss",
        "charliermarsh.ruff"
      ]
    }
  }
}
